<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="amirz.dngprocessor">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- A camera with RAW capability is required to use this application -->
    <uses-feature android:name="android.hardware.camera.capability.raw" android:required="true" />

    <!-- Tell the system this app requires OpenGL ES 3.0. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name="amirz.dngprocessor.DngProcessorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/SettingsTheme">
        <activity android:name="amirz.dngprocessor.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name="amirz.dngprocessor.ui.ToneCurveActivity"
            android:exported="false"
            android:theme="@style/ToneCurveTheme"
            android:label="Tone Curve" />
        
        <activity android:name="amirz.dngprocessor.ui.AdaptiveSaturationCurveActivity"
            android:exported="false"
            android:theme="@style/ToneCurveTheme"
            android:label="Adaptive Saturation Curve" />

        <receiver
            android:name="amirz.dngprocessor.scheduler.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name="amirz.dngprocessor.scheduler.DngScanJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:foregroundServiceType="mediaProcessing"/>

        <service
            android:name="amirz.dngprocessor.scheduler.DngParseService"
            android:foregroundServiceType="mediaProcessing"/>
            
        <!-- Disable WorkManager auto-initialization so we can configure it manually -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>